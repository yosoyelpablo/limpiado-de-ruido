<!-- SYNTHETIC: valid for Wazuh's lenient parser, NOT well-formed XML -- note the double dash here. -->
<group name="web,accesslog,">
  <rule id="31100" level="0">
    <category>web-log</category>
    <description>Synthetic: access log messages grouped & tagged.</description>
  </rule>

  <rule id="31101" level="5">
    <if_sid>31100</if_sid>
    <regex>^\S+ \S+ \S+ [\S+ \S+] "\w+ \S+ HTTP\S+" 4\d\d </regex>
    <description>Synthetic: web server 400 error code.</description>
  </rule>

  <rule id="31102" level="0">
    <if_sid>31101</if_sid>
    <regex type="pcre2">\.(?:jpg|png)$|<\w+></regex>
    <description>Synthetic: ignore static files.</description>
  </rule>
</group>
