<!--
  SYNTHETIC sshd-like chain for hushwatch tests (ids mirror the 5700 range so the dependency graph looks
  realistic; texts and values are our own). Exercises: a variable in an attribute, entities, a character
  reference, if_sid lists and correlation rules on a base rule. (No CDATA: Wazuh's os_xml does not support it.)
-->

<var name="SSHD_FREQ">8</var>

<group name="syslog,sshd,">
  <rule id="5700" level="0" noalert="1">
    <decoded_as>sshd</decoded_as>
    <description>Synthetic: SSHD messages grouped.</description>
  </rule>

  <rule id="5710" level="5">
    <if_sid>5700</if_sid>
    <match>illegal user|invalid user</match>
    <description>sshd: login attempt with a user that does not exist &amp; was rejected</description>
    <mitre>
      <id>T1110.001</id>
      <id>T1021.004</id>
    </mitre>
    <group>authentication_failed,invalid_login,pci_dss_10.2.4,</group>
  </rule>

  <rule id="5712" level="10" frequency="$SSHD_FREQ" timeframe="120" ignore="60">
    <if_matched_sid>5710</if_matched_sid>
    <same_source_ip />
    <description>sshd: brute force with non-existent users (&#x41;ttempt burst)</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="5715" level="3">
    <if_sid>5700</if_sid>
    <match>^Accepted|authenticated.$</match>
    <description>sshd: authentication succeeded.</description>
    <mitre>
      <id>T1078</id>
    </mitre>
    <group>authentication_success,</group>
  </rule>

  <rule id="5716" level="5">
    <if_sid>5700</if_sid>
    <match>^Failed password|^error: PAM: Authentication failure</match>
    <description>sshd: authentication failed.</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <rule id="5720" level="10" frequency="8">
    <if_matched_sid>5716</if_matched_sid>
    <same_source_ip />
    <description>sshd: multiple authentication failures.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>

  <rule id="5760" level="5">
    <if_sid>5700, 5716</if_sid>
    <match>Failed password|Failed keyboard</match>
    <description>sshd: authentication failed (password).</description>
    <group>authentication_failed,</group>
  </rule>
</group>
