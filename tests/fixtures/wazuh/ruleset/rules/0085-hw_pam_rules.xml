<!-- SYNTHETIC PAM-like rules for hushwatch tests. -->
<group name="pam,syslog,">
  <rule id="5500" level="0" noalert="1">
    <decoded_as>pam</decoded_as>
    <description>Synthetic: PAM messages grouped.</description>
  </rule>

  <rule id="5501" level="3">
    <if_sid>5500</if_sid>
    <match>session opened for user </match>
    <description>Synthetic PAM: login session opened.</description>
    <group>authentication_success,</group>
  </rule>

  <rule id="5502" level="3">
    <if_sid>5500</if_sid>
    <match>session closed for user </match>
    <description>Synthetic PAM: login session closed.</description>
  </rule>

  <rule id="5503" level="5">
    <if_sid>5500</if_sid>
    <match>authentication failure; </match>
    <description>Synthetic PAM: user login failed.</description>
    <mitre>
      <id>T1110.001</id>
    </mitre>
    <group>authentication_failed,</group>
  </rule>

  <!-- A frequency rule chained through if_sid (not if_matched_sid): still a correlation on 5503. -->
  <rule id="5557" level="10" frequency="6" timeframe="180">
    <if_sid>5503</if_sid>
    <same_source_ip />
    <description>Synthetic PAM: repeated login failures from one source.</description>
    <mitre>
      <id>T1110</id>
    </mitre>
    <group>authentication_failures,</group>
  </rule>
</group>
